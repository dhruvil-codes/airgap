{
  "name": "airgap-website",
  "private": true,
  "version": "0.2.0",
  "description": "Marketing and documentation site for airgap, the zero-trust microVM execution boundary for AI coding agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "lenis": "^1.3.28",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
